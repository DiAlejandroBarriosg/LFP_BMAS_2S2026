## Prueba de choques de horario y validaciones de referencia
HORARIO {
    CURSOS {
        curso: "Lenguajes Formales y de Programacion" [codigo: "LFP-0796", creditos: 4],
        curso: "Bases de Datos 2" [codigo: "BD2-0812", creditos: 5],
        curso: "Sistemas Operativos 1" [codigo: "SOP-0850", creditos: 4],
        curso: "Estructuras de Datos" [codigo: "EDD-0770", creditos: 4],
        curso: "Curso Duplicado" [codigo: "LFP-0796", creditos: 3],
    };
    CATEDRATICOS {
        catedratico: "Otto Rodriguez" [codigo: "DOC-001", categoria: TITULAR],
        catedratico: "Vivian Campos" [codigo: "DOC-002", categoria: INTERINO],
        catedratico: "Luis Barrios" [codigo: "DOC-003", categoria: AUXILIAR],
    };
    AULAS {
        aula: "A-101" [capacidad: 40, edificio: "T-3"],
        aula: "LAB-3" [capacidad: 25, edificio: "T-5"],
        aula: "B-202" [capacidad: 60, edificio: "T-1"],
    };
    CLASES {
        ## choque de catedratico: DOC-001 en dos aulas el LUNES de 07:00 a 08:40
        clase: "LFP-0796" con "DOC-001" en "A-101" [dia: LUNES, inicio: 07:00, fin: 08:40, seccion: "N"],
        clase: "BD2-0812" con "DOC-001" en "LAB-3" [dia: LUNES, inicio: 07:00, fin: 08:40, seccion: "A"],
        ## choque de aula: A-101 ocupada por dos catedraticos el MARTES traslapados
        clase: "SOP-0850" con "DOC-002" en "A-101" [dia: MARTES, inicio: 09:00, fin: 10:40, seccion: "N"],
        clase: "EDD-0770" con "DOC-003" en "A-101" [dia: MARTES, inicio: 10:00, fin: 11:40, seccion: "A"],
        ## continuidad, NO es choque: una termina 08:40 y la otra empieza 08:40
        clase: "SOP-0850" con "DOC-001" en "B-202" [dia: MIERCOLES, inicio: 07:00, fin: 08:40, seccion: "N"],
        clase: "EDD-0770" con "DOC-001" en "B-202" [dia: MIERCOLES, inicio: 08:40, fin: 10:20, seccion: "N"],
        ## mismo horario pero distinto dia: NO es choque
        clase: "LFP-0796" con "DOC-002" en "LAB-3" [dia: JUEVES, inicio: 14:00, fin: 15:40, seccion: "A"],
        clase: "BD2-0812" con "DOC-002" en "LAB-3" [dia: VIERNES, inicio: 14:00, fin: 15:40, seccion: "A"],
        ## referencias inexistentes y rango invertido
        clase: "XXX-9999" con "DOC-404" en "Z-999" [dia: SABADO, inicio: 08:00, fin: 09:40, seccion: "B"],
        clase: "EDD-0770" con "DOC-003" en "B-202" [dia: SABADO, inicio: 11:00, fin: 09:00, seccion: "B"],
    };
};

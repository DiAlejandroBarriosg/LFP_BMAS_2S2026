## Casos borde del detector de choques
HORARIO {
    CURSOS {
        curso: "Curso A" [codigo: "AAA-0001", creditos: 4],
        curso: "Curso B" [codigo: "BBB-0002", creditos: 4],
        curso: "Curso C" [codigo: "CCC-0003", creditos: 4],
    };
    CATEDRATICOS {
        catedratico: "Docente Uno" [codigo: "DOC-001", categoria: TITULAR],
        catedratico: "Docente Dos" [codigo: "DOC-002", categoria: INTERINO],
    };
    AULAS {
        aula: "A-101" [capacidad: 40, edificio: "T-3"],
        aula: "A-102" [capacidad: 40, edificio: "T-3"],
    };
    CLASES {
        ## caso 1: comparten catedratico Y aula al mismo tiempo -> un choque con dos motivos
        clase: "AAA-0001" con "DOC-001" en "A-101" [dia: LUNES, inicio: 07:00, fin: 08:40, seccion: "N"],
        clase: "BBB-0002" con "DOC-001" en "A-101" [dia: LUNES, inicio: 07:00, fin: 08:40, seccion: "A"],
        ## caso 2: contencion total, una clase dentro de otra
        clase: "AAA-0001" con "DOC-002" en "A-102" [dia: MARTES, inicio: 07:00, fin: 12:00, seccion: "N"],
        clase: "BBB-0002" con "DOC-002" en "A-101" [dia: MARTES, inicio: 09:00, fin: 10:00, seccion: "A"],
        ## caso 3: tres clases mutuamente traslapadas -> tres pares
        clase: "AAA-0001" con "DOC-001" en "A-102" [dia: MIERCOLES, inicio: 08:00, fin: 11:00, seccion: "N"],
        clase: "BBB-0002" con "DOC-001" en "A-101" [dia: MIERCOLES, inicio: 09:00, fin: 12:00, seccion: "A"],
        clase: "CCC-0003" con "DOC-001" en "A-101" [dia: MIERCOLES, inicio: 10:00, fin: 13:00, seccion: "B"],
        ## caso 4: mismo dia y hora, sin recurso compartido -> NO es choque
        clase: "AAA-0001" con "DOC-001" en "A-101" [dia: JUEVES, inicio: 07:00, fin: 08:40, seccion: "N"],
        clase: "BBB-0002" con "DOC-002" en "A-102" [dia: JUEVES, inicio: 07:00, fin: 08:40, seccion: "A"],
        ## caso 5: dia saturado, para probar que no queden bloques libres
        clase: "AAA-0001" con "DOC-002" en "A-101" [dia: VIERNES, inicio: 06:00, fin: 21:00, seccion: "N"],
        clase: "BBB-0002" con "DOC-002" en "A-101" [dia: VIERNES, inicio: 07:00, fin: 08:40, seccion: "A"],
    };
};

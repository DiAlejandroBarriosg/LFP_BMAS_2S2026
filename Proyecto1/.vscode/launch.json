{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HorarioScript (ventana vacia)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "HorarioScript (horario completo)",
            "type": "debugpy",

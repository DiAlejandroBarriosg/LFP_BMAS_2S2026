            "program": "${workspaceFolder}/main.py",
            "args": ["entradas/horario_completo.hor"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pruebas: motor lexico",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/pruebas_consola.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pruebas: choques",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/pruebas_choques.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
